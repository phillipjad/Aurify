# Root-level ignores. The frontend has its own .gitignore as well.

# Environment / secrets
.env
.env.*
!.env.example

# Go (backend)
backend/bin/
*.test
*.out

# Local Docker data (MongoDB bind mount, see docker-compose.yml)
.data/

# Node (frontend)
node_modules/
dist/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
