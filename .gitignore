# Root-level ignores. The frontend has its own .gitignore as well.

# Environment / secrets
.env
.env.*
# Committed. Despite matching .env.* above, this is the base configuration
# layer that docker-compose actually loads, not merely a sample to copy.
!.env.default
# The frontend is not containerized, so its file really is a sample.
!.env.example

# Go (backend)
backend/bin/
*.test
*.out

# Local Docker data (MongoDB bind mount, see docker-compose.yml)
.data/

# Node (frontend)
node_modules/
dist/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Agentic data
impeccable.json
.impeccable
.claude/
.playwright-mcp/

# Terraform / OpenTofu working files. `tofu init` writes .terraform/ into each
# module, and state must never be committed: this project keeps it in a GCS
# backend (deploy/README.md).
#
# .terraform.lock.hcl is deliberately absent from this list. It pins the exact
# provider versions and hashes every checkout resolves, so it is committed —
# see deploy/app/.terraform.lock.hcl.
.terraform/
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files, which are where credentials end up by accident. The modules
# take their inputs on the command line and from Secret Manager (ADR 0013).
*.tfvars
*.tfvars.json