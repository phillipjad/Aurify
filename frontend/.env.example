# Aurify frontend configuration. Copy to .env.local for local overrides.

# Base URL of the API. In dev this is proxied to the Go backend (vite.config.ts),
# so the default relative path works without setting anything.
VITE_API_BASE_URL=/api/v1

# SCAFFOLD ONLY: a dev user id sent as the X-User-ID header until real auth is
# wired. Remove once session/JWT auth lands.
VITE_DEV_USER_ID=demo-user
