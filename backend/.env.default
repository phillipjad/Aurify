# Aurify backend configuration: the base layer every stack actually runs with.
#
# docker-compose loads this file, then .env.dev, then .env, with later files
# winning. So this is not a sample to copy: editing it changes what everyone's
# stack runs with. Put personal overrides in .env (gitignored) instead.

# There is no development mode. Development substitutes real infrastructure
# instead: docker-compose runs Mailpit, a real SMTP server, so the verification
# and password-reset paths that run locally are the same code that runs for real
# users. Run ./scripts/dev-setup.sh to generate a local config.
#
# A mail relay and a signing key are therefore required in every environment.
# That is deliberate: an unsafe configuration is not representable rather than
# merely gated behind a flag someone could set by accident.

# HTTP
AURIFY_HTTP_ADDR=:8080
AURIFY_CORS_ORIGINS=http://localhost:5173

# PostgreSQL (schema is created/updated automatically on startup via goose)
AURIFY_DATABASE_URL=postgres://aurify:aurify@localhost:5432/aurify?sslmode=disable

# Lyrics source
AURIFY_LRCLIB_URL=https://lrclib.net

# Prompt generation: any OpenAI-compatible chat-completions provider.
# See docs/adr/0016-generation-providers.md.
#
# Empty means "use the built-in placeholder prompt", which is what a checkout
# with no model configured runs on. For a local model:
#
#   brew install ollama && ollama serve && ollama pull gemma3:4b
#
# then set the URL in your own .env. Ollama runs on the host rather than as a
# compose service because Docker on macOS cannot reach Metal, so which hostname
# you want depends on where the API itself is running:
#
#   http://host.docker.internal:11434/v1   the compose stack (start_container.sh)
#   http://localhost:11434/v1              the API run directly on the host
#
# The same variables point at Groq, OpenRouter, Cerebras or OpenAI instead: set
# their base URL, their model, and AURIFY_PROMPTGEN_API_KEY.
AURIFY_PROMPTGEN_URL=
AURIFY_PROMPTGEN_MODEL=gemma3:4b
AURIFY_PROMPTGEN_API_KEY=

# Image generation: any OpenAI-compatible images provider.
#
# Gemini by default, through its OpenAI-compatibility layer: 500 images a day on
# the free tier, no card, no expiry. Create a key at aistudio.google.com/apikey
# and set it in your own .env. Leave it empty to render the local placeholder.
#
# This replaced Cloudflare Workers AI, whose safety classifier refused about a
# quarter of ordinary abstract-art prompts with no way to opt out. OpenAI and
# Together are reachable from the same three settings; note that Together spells
# response_format "base64" where everyone else uses "b64_json".
AURIFY_IMAGEGEN_URL=https://generativelanguage.googleapis.com/v1beta/openai
AURIFY_IMAGEGEN_MODEL=gemini-2.5-flash-image
AURIFY_IMAGEGEN_API_KEY=

# DSP OAuth credentials (obtain from each provider's developer console)
AURIFY_SPOTIFY_CLIENT_ID=
AURIFY_SPOTIFY_CLIENT_SECRET=
AURIFY_SPOTIFY_REDIRECT_URL=http://localhost:8080/api/v1/auth/spotify/callback

AURIFY_APPLE_CLIENT_ID=
AURIFY_APPLE_CLIENT_SECRET=
AURIFY_APPLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/apple_music/callback

# YouTube Music uses Google OAuth + the YouTube Data API v3: create a "Web
# application" OAuth client in Google Cloud Console, enable "YouTube Data API
# v3", and register the redirect URL below on that client.
AURIFY_YOUTUBE_CLIENT_ID=
AURIFY_YOUTUBE_CLIENT_SECRET=
AURIFY_YOUTUBE_REDIRECT_URL=http://localhost:8080/api/v1/auth/youtube_music/callback

# ---------------------------------------------------------------------------
# Authentication (see ADR 0011)
# ---------------------------------------------------------------------------

# Public origin of the web app. Verification and password-reset links are built
# against this, so it must be an address the user's browser can actually reach.
AURIFY_APP_BASE_URL=http://localhost:5173

# Ed25519 signing key: base64 of a 32-byte seed.
#
# REQUIRED IN PRODUCTION. Left empty the API generates an ephemeral key at
# startup and warns: every restart invalidates outstanding access tokens, and
# two instances will reject each other's tokens.
#
# Generate one with:
#   head -c 32 /dev/urandom | base64
AURIFY_AUTH_SIGNING_KEY=

AURIFY_AUTH_ISSUER=aurify
AURIFY_AUTH_AUDIENCE=aurify-api

# Access token lifetime. Access tokens are verified statelessly, so this is also
# how long a revoked session keeps working. Keep it short.
AURIFY_AUTH_ACCESS_TTL=15m
# Refresh token idle timeout.
AURIFY_AUTH_REFRESH_TTL=720h
# Absolute session cap, regardless of how often it is refreshed.
AURIFY_AUTH_SESSION_TTL=2160h

# Marks auth cookies Secure. Leave true everywhere except local HTTP
# development: a browser silently drops a Secure cookie sent over plain http,
# so sign-in appears to succeed and then nothing is authenticated. Set false to
# test the browser flow against http://localhost.
AURIFY_AUTH_COOKIE_SECURE=true

# Shown to users who hit the permanent lockout, since only an operator can lift
# one (see ADR 0012). Point this at a monitored address before launch.
AURIFY_SUPPORT_EMAIL=support@aurify.local

# Sign in with Google (OpenID Connect authorization-code flow with PKCE).
#
# Leave empty to disable: the routes then answer 501 and the frontend hides the
# button. This is a SEPARATE OAuth client from AURIFY_YOUTUBE_* above, and must
# stay separate — that one grants access to a music library, this one asserts
# who the user is, and sharing a client would let a data connection imply a
# login (see ADR 0011).
#
# Create a "Web application" OAuth client in Google Cloud Console, and register
# the redirect URL below on it.
AURIFY_GOOGLE_CLIENT_ID=
AURIFY_GOOGLE_CLIENT_SECRET=
# Points at the API's own port, matching the DSP callbacks above, so the
# container stack can complete a sign-in with no frontend dev server running.
# Cookies are scoped by host and ignore the port, so the session cookie this
# sets on localhost:8080 is still sent to the app on localhost:5173.
#
# Local only. Google requires HTTPS for every non-localhost redirect URI, so a
# deployment sets its real public URL here, for example
# https://aurify.example/api/v1/auth/federated/google/callback. That URL is the
# browser-facing one and is unrelated to AURIFY_HTTP_ADDR, which is only the
# port the process listens on behind the ingress.
AURIFY_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/federated/google/callback

# ---------------------------------------------------------------------------
# Outbound mail (SMTP2GO by default, but any SMTP relay works)
# ---------------------------------------------------------------------------
# Required in every environment. Locally this points at the Mailpit container
# (see scripts/dev-setup.sh); in production at SMTP2GO or any other relay.
#
# An invalid configuration is a startup failure rather than a silent downgrade,
# since undelivered mail otherwise presents as users simply unable to sign up or
# recover an account, with nothing looking unhealthy.
AURIFY_SMTP_HOST=
AURIFY_SMTP_PORT=2525
# Require STARTTLS. Only ever false for a relay on the local machine.
AURIFY_SMTP_TLS=true
AURIFY_SMTP_USERNAME=
AURIFY_SMTP_PASSWORD=
AURIFY_SMTP_FROM=no-reply@aurify.local
