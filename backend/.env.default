# Aurify backend configuration. Committed and genuinely loaded, not a sample:
# editing it changes what everyone's stack runs with. Override in .env.
# See docs/environment-variables.md for what each setting means.

# HTTP
AURIFY_HTTP_ADDR=:8080
AURIFY_CORS_ORIGINS=http://localhost:5173

# PostgreSQL (migrated on startup via goose)
AURIFY_DATABASE_URL=postgres://aurify:aurify@localhost:5432/aurify?sslmode=disable

# Lyrics source
AURIFY_LRCLIB_URL=https://lrclib.net

# Prompt generation: any OpenAI-compatible provider. Empty URL = placeholder prompt.
AURIFY_PROMPTGEN_URL=
AURIFY_PROMPTGEN_MODEL=gemma3:4b
AURIFY_PROMPTGEN_API_KEY=

# Image generation: Cloudflare Workers AI. Empty account or key = placeholder image.
AURIFY_IMAGEGEN_ACCOUNT_ID=
AURIFY_IMAGEGEN_API_KEY=
AURIFY_IMAGEGEN_MODEL=@cf/bytedance/stable-diffusion-xl-lightning
# Only to aim the client at a test server.
AURIFY_IMAGEGEN_URL=

# DSP OAuth credentials (from each provider's developer console)
AURIFY_SPOTIFY_CLIENT_ID=
AURIFY_SPOTIFY_CLIENT_SECRET=
AURIFY_SPOTIFY_REDIRECT_URL=http://localhost:8080/api/v1/auth/spotify/callback

AURIFY_APPLE_CLIENT_ID=
AURIFY_APPLE_CLIENT_SECRET=
AURIFY_APPLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/apple_music/callback

AURIFY_YOUTUBE_CLIENT_ID=
AURIFY_YOUTUBE_CLIENT_SECRET=
AURIFY_YOUTUBE_REDIRECT_URL=http://localhost:8080/api/v1/auth/youtube_music/callback

# Authentication (see ADR 0011)
AURIFY_APP_BASE_URL=http://localhost:5173
# Required in production: head -c 32 /dev/urandom | base64
AURIFY_AUTH_SIGNING_KEY=
AURIFY_AUTH_ISSUER=aurify
AURIFY_AUTH_AUDIENCE=aurify-api
AURIFY_AUTH_ACCESS_TTL=15m
AURIFY_AUTH_REFRESH_TTL=720h
AURIFY_AUTH_SESSION_TTL=2160h
# False only for local HTTP development.
AURIFY_AUTH_COOKIE_SECURE=true
AURIFY_SUPPORT_EMAIL=support@aurify.local

# Sign in with Google. Empty disables it; a SEPARATE client from AURIFY_YOUTUBE_*.
AURIFY_GOOGLE_CLIENT_ID=
AURIFY_GOOGLE_CLIENT_SECRET=
AURIFY_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/federated/google/callback

# Outbound mail. Required in every environment; startup fails without a host.
AURIFY_SMTP_HOST=
AURIFY_SMTP_PORT=2525
AURIFY_SMTP_TLS=true
AURIFY_SMTP_USERNAME=
AURIFY_SMTP_PASSWORD=
AURIFY_SMTP_FROM=no-reply@aurify.local
